<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal"
    android:background="#FF1A1A2E">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="Maker App"
        android:textSize="32sp"
        android:textColor="#FFE94560"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Game Development Toolkit"
        android:textSize="14sp"
        android:textColor="#FF8888AA" />

    <View
        android:layout_width="64dp"
        android:layout_height="2dp"
        android:layout_marginTop="24dp"
        android:background="#FFE94560" />

    <TextView
        android:id="@+id/status_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:padding="16dp"
        android:text="检查中..."
        android:textSize="14sp"
        android:textColor="#FFCCCCDD"
        android:background="#FF16213E"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

    <Button
        android:id="@+id/btn_setup"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"
        android:text="安装 Node.js"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:background="#FFE94560"
        android:textColor="#FFFFFFFF"
        android:stateListAnimator="@null" />

    <Button
        android:id="@+id/btn_terminal"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:text="打开终端"
        android:textAllCaps="false"
        android:textSize="16sp"
        android:background="#FF16213E"
        android:textColor="#FFE94560"
        android:enabled="false"
        android:stateListAnimator="@null" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="使用说明"
        android:textSize="14sp"
        android:textColor="#FFE94560"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="1. 点击「安装 Node.js」安装运行时\n2. 安装完成后点击「打开终端」\n3. 在终端中运行 npx 命令"
        android:textSize="13sp"
        android:textColor="#FF8888AA"
        android:lineSpacingExtra="4dp" />

</LinearLayout>