<?xml version="1.0" encoding="utf-8"?>
<!--
    Coomi 控制台：浅灰页面 + 白色分组卡片（DeepSeek 设置页的排版语言）。
    ID 与 CoomiDashboardActivity 对应：dashboard_status_indicator / dashboard_status_text /
    dashboard_runtime_version / btn_open_chat / btn_restart / btn_stop /
    btn_open_terminal / btn_open_tui / btn_open_webui / webui_button_container。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/coomi_page"
    android:fitsSystemWindows="true"
    tools:context="app.coomi.CoomiDashboardActivity">

    <!-- ── 顶栏 ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/coomi_gutter"
        android:paddingEnd="@dimen/coomi_gutter">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/coomi_logo"
            android:contentDescription="@string/coomi_brand"/>

        <TextView
            style="@style/Coomi.Text.Heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/coomi_space_s"
            android:text="@string/coomi_dash_title"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/coomi_gutter"
            android:paddingEnd="@dimen/coomi_gutter"
            android:paddingTop="@dimen/coomi_space_xs"
            android:paddingBottom="@dimen/coomi_space_xl">

            <!-- ── 主入口：进入对话 ── -->
            <LinearLayout
                android:id="@+id/btn_open_chat"
                style="@style/Coomi.Row"
                android:background="@drawable/coomi_bg_card"
                android:clickable="true"
                android:focusable="true"
                android:paddingTop="@dimen/coomi_space_l"
                android:paddingBottom="@dimen/coomi_space_l">

                <FrameLayout
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/coomi_bg_icon_tile">

                    <ImageView
                        android:layout_width="@dimen/coomi_icon_m"
                        android:layout_height="@dimen/coomi_icon_m"
                        android:layout_gravity="center"
                        android:src="@drawable/coomi_ic_chat"
                        android:tint="@color/coomi_blue"
                        android:contentDescription="@null"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/coomi_space_m"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Coomi.Text.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:text="@string/coomi_dash_open_chat"/>

                    <TextView
                        style="@style/Coomi.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/coomi_dash_open_chat_desc"/>
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/coomi_icon_s"
                    android:layout_height="@dimen/coomi_icon_s"
                    android:src="@drawable/coomi_ic_chevron_right"
                    android:tint="@color/coomi_text_3"
                    android:contentDescription="@null"/>
            </LinearLayout>

            <!-- ── 引擎 ── -->
            <TextView
                style="@style/Coomi.Text.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/coomi_space_l"
                android:text="@string/coomi_dash_section_engine"/>

            <LinearLayout style="@style/Coomi.Card">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/coomi_row_height"
                    android:paddingStart="@dimen/coomi_space_l"
                    android:paddingEnd="@dimen/coomi_space_l">

                    <View
                        android:id="@+id/dashboard_status_indicator"
                        android:layout_width="9dp"
                        android:layout_height="9dp"
                        android:background="@drawable/coomi_dot_idle"/>

                    <TextView
                        android:id="@+id/dashboard_status_text"
                        style="@style/Coomi.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="@string/coomi_dash_engine_stopped"/>
                </LinearLayout>

                <View style="@style/Coomi.Divider"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/coomi_space_m">

                    <Button
                        android:id="@+id/btn_restart"
                        style="@style/Coomi.Button.Outline"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:paddingStart="@dimen/coomi_space_s"
                        android:paddingEnd="@dimen/coomi_space_s"
                        android:textSize="@dimen/coomi_text_body"
                        android:text="@string/coomi_dash_restart"/>

                    <Button
                        android:id="@+id/btn_stop"
                        style="@style/Coomi.Button.Danger"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/coomi_space_m"
                        android:paddingStart="@dimen/coomi_space_s"
                        android:paddingEnd="@dimen/coomi_space_s"
                        android:textSize="@dimen/coomi_text_body"
                        android:text="@string/coomi_dash_stop"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── 运行时 ── -->
            <TextView
                style="@style/Coomi.Text.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/coomi_space_l"
                android:text="@string/coomi_dash_section_runtime"/>

            <LinearLayout style="@style/Coomi.Card">

                <LinearLayout
                    style="@style/Coomi.Row"
                    android:background="@color/coomi_transparent">

                    <TextView
                        style="@style/Coomi.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/coomi_dash_runtime"/>

                    <TextView
                        android:id="@+id/dashboard_runtime_version"
                        style="@style/Coomi.Text.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"/>
                </LinearLayout>

                <View style="@style/Coomi.Divider"/>

                <LinearLayout
                    style="@style/Coomi.Row"
                    android:background="@color/coomi_transparent">

                    <TextView
                        style="@style/Coomi.Text.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/coomi_dash_nodejs"/>

                    <TextView
                        android:id="@+id/dashboard_nodejs_version"
                        style="@style/Coomi.Text.Mono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-"/>
                </LinearLayout>

                <View style="@style/Coomi.Divider"/>

                <LinearLayout
                    android:id="@+id/btn_open_terminal"
                    style="@style/Coomi.Row"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/coomi_icon_m"
                        android:layout_height="@dimen/coomi_icon_m"
                        android:src="@drawable/coomi_ic_terminal"
                        android:tint="@color/coomi_text_2"
                        android:contentDescription="@null"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/coomi_space_m"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Coomi.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/coomi_dash_terminal"/>

                        <TextView
                            style="@style/Coomi.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/coomi_dash_terminal_desc"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/coomi_icon_s"
                        android:layout_height="@dimen/coomi_icon_s"
                        android:src="@drawable/coomi_ic_chevron_right"
                        android:tint="@color/coomi_text_3"
                        android:contentDescription="@null"/>
                </LinearLayout>

                <View style="@style/Coomi.Divider"/>

                <LinearLayout
                    android:id="@+id/btn_open_tui"
                    style="@style/Coomi.Row"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="@dimen/coomi_icon_m"
                        android:layout_height="@dimen/coomi_icon_m"
                        android:src="@drawable/coomi_ic_cube"
                        android:tint="@color/coomi_text_2"
                        android:contentDescription="@null"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/coomi_space_m"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Coomi.Text.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/coomi_dash_tui"/>

                        <TextView
                            style="@style/Coomi.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/coomi_dash_tui_desc"/>
                    </LinearLayout>

                    <ImageView
                        android:layout_width="@dimen/coomi_icon_s"
                        android:layout_height="@dimen/coomi_icon_s"
                        android:src="@drawable/coomi_ic_chevron_right"
                        android:tint="@color/coomi_text_3"
                        android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Coomi.Text.SectionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/coomi_space_l"
                android:text="@string/coomi_dash_section_settings"/>

            <LinearLayout style="@style/Coomi.Card">
                <LinearLayout
                    android:id="@+id/btn_permission_settings"
                    style="@style/Coomi.Row"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="@dimen/coomi_icon_m"
                        android:layout_height="@dimen/coomi_icon_m"
                        android:src="@drawable/coomi_ic_shield"
                        android:tint="@color/coomi_text_2"
                        android:contentDescription="@null"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/coomi_space_m"
                        android:orientation="vertical">
                        <TextView style="@style/Coomi.Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/coomi_dash_permission_settings"/>
                        <TextView style="@style/Coomi.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/coomi_dash_permission_settings_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="@dimen/coomi_icon_s" android:layout_height="@dimen/coomi_icon_s" android:src="@drawable/coomi_ic_chevron_right" android:tint="@color/coomi_text_3" android:contentDescription="@null"/>
                </LinearLayout>
                <View style="@style/Coomi.Divider"/>
                <LinearLayout
                    android:id="@+id/btn_storage_settings"
                    style="@style/Coomi.Row"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageView
                        android:layout_width="@dimen/coomi_icon_m"
                        android:layout_height="@dimen/coomi_icon_m"
                        android:src="@drawable/coomi_ic_folder"
                        android:tint="@color/coomi_text_2"
                        android:contentDescription="@null"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/coomi_space_m"
                        android:orientation="vertical">
                        <TextView style="@style/Coomi.Text.Body" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/coomi_dash_storage_settings"/>
                        <TextView style="@style/Coomi.Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/coomi_dash_storage_settings_desc"/>
                    </LinearLayout>
                    <ImageView android:layout_width="@dimen/coomi_icon_s" android:layout_height="@dimen/coomi_icon_s" android:src="@drawable/coomi_ic_chevron_right" android:tint="@color/coomi_text_3" android:contentDescription="@null"/>
                </LinearLayout>
            </LinearLayout>

            <!-- ── 工具（仅引擎运行时可见） ── -->
            <LinearLayout
                android:id="@+id/webui_button_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Coomi.Text.SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/coomi_space_l"
                    android:text="@string/coomi_dash_section_tools"/>

                <LinearLayout style="@style/Coomi.Card">

                    <LinearLayout
                        android:id="@+id/btn_open_webui"
                        style="@style/Coomi.Row"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/coomi_icon_m"
                            android:layout_height="@dimen/coomi_icon_m"
                            android:src="@drawable/coomi_ic_globe"
                            android:tint="@color/coomi_text_2"
                            android:contentDescription="@null"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/coomi_space_m"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Coomi.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/coomi_dash_browser"/>

                            <TextView
                                style="@style/Coomi.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/coomi_dash_browser_desc"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/coomi_icon_s"
                            android:layout_height="@dimen/coomi_icon_s"
                            android:src="@drawable/coomi_ic_external"
                            android:tint="@color/coomi_text_3"
                            android:contentDescription="@null"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_open_catalog"
                        style="@style/Coomi.Row"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/coomi_icon_m"
                            android:layout_height="@dimen/coomi_icon_m"
                            android:src="@drawable/coomi_ic_cube"
                            android:tint="@color/coomi_text_2"
                            android:contentDescription="@null"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/coomi_space_m"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Coomi.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/coomi_dash_catalog"/>

                            <TextView
                                style="@style/Coomi.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/coomi_dash_catalog_desc"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/coomi_icon_s"
                            android:layout_height="@dimen/coomi_icon_s"
                            android:src="@drawable/coomi_ic_chevron_right"
                            android:tint="@color/coomi_text_3"
                            android:contentDescription="@null"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_open_files"
                        style="@style/Coomi.Row"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/coomi_icon_m"
                            android:layout_height="@dimen/coomi_icon_m"
                            android:src="@drawable/coomi_ic_folder"
                            android:tint="@color/coomi_text_2"
                            android:contentDescription="@null"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/coomi_space_m"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Coomi.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/coomi_dash_files"/>

                            <TextView
                                style="@style/Coomi.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/coomi_dash_files_desc"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/coomi_icon_s"
                            android:layout_height="@dimen/coomi_icon_s"
                            android:src="@drawable/coomi_ic_chevron_right"
                            android:tint="@color/coomi_text_3"
                            android:contentDescription="@null"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_check_update"
                        style="@style/Coomi.Row"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:layout_width="@dimen/coomi_icon_m"
                            android:layout_height="@dimen/coomi_icon_m"
                            android:src="@drawable/coomi_ic_download"
                            android:tint="@color/coomi_text_2"
                            android:contentDescription="@null"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/coomi_space_m"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Coomi.Text.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/coomi_dash_check_update"/>

                            <TextView
                                style="@style/Coomi.Text.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/coomi_dash_check_update_desc"/>
                        </LinearLayout>

                        <ImageView
                            android:layout_width="@dimen/coomi_icon_s"
                            android:layout_height="@dimen/coomi_icon_s"
                            android:src="@drawable/coomi_ic_chevron_right"
                            android:tint="@color/coomi_text_3"
                            android:contentDescription="@null"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
